@model Whistleblowing.NET.Models.PaginatedSegnalazioniRegularViewUtente

<link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Pagination.css" asp-append-version="true" />


<style>
    #success-alert {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }

    .title-text {
        font-size: 1.2rem;
    }

    .mini-card {
        background-color: #d4edda;
        border-radius: 7px;
        padding: 10px;
        width: 20%;
    }

    .btn-danger {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
    }

    th {
        font-size: 1.1rem;
        vertical-align: middle;
    }

    .styled-table th,
    .styled-table td {
        text-align: center;
        vertical-align: middle;
    }

    .pagination-custom {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination .page-item .page-link {
        color: #007bff;
        border: 1px solid #dee2e6;
        padding: 0.375rem 0.75rem;
        margin: 0 0.2rem;
        border-radius: 0.25rem;
    }

    .pagination .page-item.active .page-link {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
        background-color: #f8f9fa;
        border-color: #dee2e6;
        cursor: not-allowed;
    }
</style>

<div class="row align-items-center mb-2">
    <div class="col-md-8">
        <h3>Gestione Segnalazioni</h3>
        <p class="title-text mt-2">
            In questa sezione del programma puoi visualizzare tutte le tue segnalazioni.
        </p>
    </div>
    <div class="col-md-4 text-md-end">
        <div class="mini-card ms-5" style="padding: 15px; display: inline-block; width: auto; box-sizing: border-box;">
            <h6 class="card-subtitle mb-1 text-muted" style="margin: 0;">Segnalazioni Totali:</h6>
            <p class="font-weight-bold mb-0" style="font-size: 1.2rem; margin: 0;">@Model.TotalItems</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive mt-3">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th class="text-center font-weight-bold">ID</th>
                        <th class="text-center font-weight-bold">Data Evento</th>
                        <th class="text-center font-weight-bold">Soggetto Colpevole</th>
                        <th class="text-center font-weight-bold">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SegnalazioniRegulars != null && Model.SegnalazioniRegulars.Count > 0)
                    {
                        foreach (var segnalazione in Model.SegnalazioniRegulars)
                        {
                            <tr>
                                <td style="vertical-align: middle;">
                                    <a asp-controller="SegnalazioniRegular" asp-action="GetSegnalazioneRegularById" asp-route-id="@segnalazione.segnalazione_regular_id" style="color: inherit; text-decoration: none;">
                                        @segnalazione.segnalazione_regular_id
                                    </a>
                                </td>
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.DataEvento?.ToString("yyyy-MM-dd")</td>
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.SoggettoColpevole</td>
                                <td class="text-center" style="vertical-align: middle;">
                                    <a class="btn btn-info btn-sm" asp-controller="SegnalazioniRegular" asp-action="GetSegnalazioneRegularById" asp-route-id="@segnalazione.segnalazione_regular_id">
                                        <i class="bi bi-eye"></i> Visualizza
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Nessuna segnalazione trovata.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="align-content">
    @if (Model.TotalItems != 0)
    {
        <p style="margin-bottom: 0px;">
            Segnalazioni:
            @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Model.PageNumber * Model.PageSize > Model.TotalItems ? Model.TotalItems : Model.PageNumber * Model.PageSize)
            di @Model.TotalItems
        </p>
    }

    <ul class="pagination-custom">
        <!-- Prima Pagina -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="GetMySegnalazioniRegular" asp-route-pageNumber="1" asp-route-pageSize="@Model.PageSize">Prima pagina</a>
        </li>

        <!-- Precedente -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="GetMySegnalazioniRegular" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Precedente</a>
        </li>

        <!-- Numeri delle pagine -->
        @{
            var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
        }
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="page-link" asp-action="GetMySegnalazioniRegular" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
            </li>
        }

        <!-- Successivo -->
        <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="GetMySegnalazioniRegular" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Successivo</a>
        </li>

        <!-- Ultima Pagina -->
        <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="GetMySegnalazioniRegular" asp-route-pageNumber="@totalPages" asp-route-pageSize="@Model.PageSize">Ultima pagina</a>
        </li>
    </ul>


</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(() => {
        // Protezione contro valori di paginazione non validi
        const currentPage = parseInt('@Model.PageNumber');
        const totalPages = parseInt('@Math.Ceiling((double)Model.TotalItems / Model.PageSize)');
        if (currentPage > totalPages || currentPage < 1) {
            alert("Pagina non valida! Reindirizzamento alla prima pagina.");
            window.location.href = '?pageNumber=1&pageSize=@Model.PageSize';
        }


        setTimeout(() => {
            const alertElement = $("#success-alert");
            if (alertElement.length) {
                alertElement.fadeOut(500, () => {
                    alertElement.remove(); // Rimuove completamente l'elemento dal DOM
                });
            }
        }, 5000); // Timeout di 5 secondi
    
    });
</script>
