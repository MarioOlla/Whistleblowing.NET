@model Whistleblowing.NET.Models.PaginatedSegnalazioniRegularViewModel

<link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Pagination.css" asp-append-version="true" />

<style>
    #success-alert {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }

    .title-text {
        font-size: 1.2rem;
    }

    .mini-card {
        background-color: #d4edda;
        border-radius: 7px;
        padding: 10px;
        width: 20%;
    }


    .btn-danger {
        background-color: #dc3545 !important; /* Forza il colore rosso */
        border-color: #dc3545 !important;
    }

    th {
        font-size: 1.1rem; /* Dimensione del testo (opzionale) */
        vertical-align: middle;
    }

</style>



<div class="row">
    <div class="col-md-10">
        <div>
            <h3>Gestione Segnalazioni</h3>
        </div>
        <p class="title-text mt-2">
            In questa sezione del programma è possibile visualizzare tutte le segnalazioni.
        </p>
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-3 mt-1">
        <div class="card" style="border-radius: 7px; margin-bottom: 24px;">
            <div class="card-body">
                <div class="d-flex align-items-center" style="justify-content: space-between;">
                    <div>
                        <h6 class="card-subtitle mb-1 text-muted">Segnalazioni Totali:</h6>
                        <p class="font-weight-bold" style="font-size:28px;">@Model.SegnalazioniRegulars.Count()</p> <!-- Visualizza il numero totale -->
                    </div>
                    <i class="bi bi-exclamation-circle" style="color: black; font-size:28px;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="border-grey bg-white tab-content">
    <div class="tab-pane active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th class="text-center font-weight-bold">
                            <a style="color: white; text-decoration: none;" asp-action="DettaglioSegnalazioneRegular">ID</a>
                        </th>
                        <th> Data Evento</th>
                        <th class="text-center  class="text-center font-weight-bold">Soggetto Colpevole</th>
                        <th class="text-center  class="text-center font-weight-bold">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SegnalazioniRegulars != null && Model.SegnalazioniRegulars.Count > 0)
                    {
                        foreach (var segnalazione in Model.SegnalazioniRegulars)
                        {
                            <tr>
                                <!-- Campo ID cliccabile -->
                                <td style="vertical-align: middle;">
                                    <a asp-controller="SegnalazioniRegular" asp-action="getSegnalazioneRegularById" asp-route-id="@segnalazione.Id_segnalazioneRegular" style="color: inherit; text-decoration: none;">
                                        @segnalazione.Id_segnalazioneRegular
                                    </a>
                                </td>
                                <td class="text-center"  style="vertical-align: middle;">@segnalazione.DataEvento?.ToString("yyyy-MM-dd")</td>
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.SoggettoColpevole</td>


                                <!-- Colonna Azioni centrata -->
                                <td class="text-center" style="vertical-align: middle;">
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@segnalazione.Id_segnalazioneRegular">
                                        <i class="bi bi-pencil-square"></i> Modifica
                                    </a>
                                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@segnalazione.Id_segnalazioneRegular">
                                        <i class="bi bi-eye"></i> Visualizza
                                    </a>
                                    <button class="btn btn-danger btn-sm" onclick="confirmDelete('@segnalazione.Id_segnalazioneRegular')">
                                        <i class="bi bi-trash"></i> Elimina
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="record-not-found text-center" role="alert">
                                    Nessuna segnalazione trovata.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* <div class="align-content">
            @if (Model.TotalItems != 0)
            {
                <p style="margin-bottom: 0px;">
                    Segnalazioni:
                    @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Model.PageNumber * Model.PageSize) di @Model.TotalItems
                </p>
            }
            <nav>
                <ul class="pagination-custom">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@Model.PageSize">Prima pagina</a>
                    </li>
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Precedente</a>
                    </li>
                    @for (int i = 1; i <= Math.Ceiling((double)Model.TotalItems / Model.PageSize); i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber == Math.Ceiling((double)Model.TotalItems / Model.PageSize) ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Successivo</a>
                    </li>
                    <li class="page-item @(Model.PageNumber == Math.Ceiling((double)Model.TotalItems / Model.PageSize) ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Math.Ceiling((double)Model.TotalItems / Model.PageSize))" asp-route-pageSize="@Model.PageSize">Ultima pagina</a>
                    </li>
                </ul>
            </nav>
        </div> *@
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div id="success-alert" class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<script>
    $(document).ready(() => {
        // Nasconde l'alert di successo dopo 5 secondi
        setTimeout(() => {
            $("#success-alert").fadeOut();
        }, 5000);
    });
</script>
