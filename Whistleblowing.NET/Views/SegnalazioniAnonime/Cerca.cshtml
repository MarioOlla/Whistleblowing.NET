@{
    ViewData["Title"] = "Cerca";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whistleblowing</title>

    <style> 

    </style>
</head>
<body>
    <h2>Trova Segnalazione</h2>
    <form asp-controller="SegnalazioniAnonime" asp-action="DecryptUserHashed" method="GET">
        <div>
            <label for="userHashed">Codice Segnalazione (Nota)</label>
            <!-- Modificato campo input in textarea -->
            <textarea id="userHashed" name="userHashed" placeholder="Inserire il codice della segnalazione" required></textarea>
        </div>
        <div>
            <label for="pwd">Password</label>
            <input type="password" id="pwd" name="pwd" placeholder="Inserisci password" required />
        </div>
        <button type="submit">Trova Segnalazione</button>
    </form>
</body>

</html>