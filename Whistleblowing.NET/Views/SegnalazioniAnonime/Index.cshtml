@model Whistleblowing.NET.Models.PaginatedSegnalazioniAnonimeViewModel


<link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Pagination.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


<style>
    #success-alert {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }

    .title-text {
        font-size: 1.2rem;
    }

    .mini-card {
        background-color: #d4edda;
        border-radius: 7px;
        padding: 10px;
        width: 20%;
    }

    .btn-danger {
        background-color: #dc3545 !important; /* Forza il colore rosso */
        border-color: #dc3545 !important;
    }

    th {
        font-size: 1.1rem;
        vertical-align: middle;
    }






</style>


<div class="row align-items-center mb-2">
    <div class="col-md-8">
        <h3>Gestione Segnalazioni</h3>
    </div>
    <div class="col-md-4 text-md-end">
        <div class="mini-card ms-5" style="padding: 15px; display: inline-block; width: auto; box-sizing: border-box;">
            <h6 class="card-subtitle mb-1 text-muted" style="margin: 0;">Segnalazioni Totali:</h6>
            <p class="font-weight-bold mb-0" style="font-size: 1.2rem; margin: 0;">@Model.TotalItems</p>
        </div>
    </div>
</div>

<p class="title-text mt-2">
    In questa sezione del programma è possibile visualizzare tutte le segnalazioni.
</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="success-alert" class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>

        }
<style>
    .custom-date {
        border: 2px solid #007bff; /* Bordo blu */
        border-radius: 6px; /* Bordi arrotondati */
        padding: 8px; /* Spaziatura interna */
        background-color: #f8f9fa; /* Grigio chiaro */
        width: 100%; /* Occupa tutta la colonna */
    }
</style>

<form id="filterForm" method="get" asp-controller="SegnalazioniAnonime" asp-action="Index">
    <div class="row g-3 align-items-end">
        <!-- Campo ID -->
        <div class="col-md-2">
            <label for="segnalazioneId" class="form-label"><strong>ID Segnalazione:</strong></label>
            <input type="number" class="form-control" id="segnalazioneId" name="segnalazioneId" placeholder="Inserisci ID">
        </div>

        <!-- Campo Stato -->
        <div class="col-md-4">
            <label for="status" class="form-label"><strong>Stato:</strong></label>
            <select class="form-select" asp-for="status" name="status">
                <option value="">Tutte</option>
                <option value="APERTO">Aperto</option>
                <option value="LAVORAZIONE">Lavorazione</option>
                <option value="CHIUSO">Chiuso</option>
            </select>
        </div>

        <!-- Campo Data con stile personalizzato -->
        <div class="col-md-4">
            <label for="searchDate" class="form-label"><strong>Data:</strong></label>
            <input type="date" class="custom-date" id="searchDate" name="searchDate" value="@ViewData["SearchDate"]">
        </div>

        <!-- Pulsante Cerca -->
        <div class="col-md-4 text-start text-md-end">
            <button type="submit" class="btn btn-primary">
                Cerca <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
</form>

<div class="border-grey bg-white tab-content">
    <div class="tab-pane active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th class="text-center font-weight-bold">Codice#</th>

                        <th class="text-center font-weight-bold">Data Evento</th>
                        <th class="text-center font-weight-bold">Soggetto Colpevole</th>
                        <th class="text-center font-weight-bold">Stato</th>

                        <th class="text-center font-weight-bold">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SegnalazioniAnonymous != null && Model.SegnalazioniAnonymous.Count > 0)
                    {
                        foreach (var segnalazione in Model.SegnalazioniAnonymous)
                        {
                            <tr id="row-@segnalazione.segnalazione_anonima_id">
                                <td class="text-center" style="vertical-align: middle;"> @($"000{segnalazione.segnalazione_anonima_id}")</td>

                                <td class="text-center" style="vertical-align: middle;">@segnalazione.DataEvento?.ToString("yyyy-MM-dd")</td>
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.SoggettoColpevole</td>
                                <td style="vertical-align: middle; text-align: center;">
                                    <span class="badge bg-@GetStatusColor(segnalazione.status.ToString()) text-white">
                                        @segnalazione.status.ToString().ToLower()
                                    </span>
                                </td>

                                <!-- Colonna Azioni centrata -->
                                <td class="text-center" style="vertical-align: middle;">
                                    <a href="@Url.Action("ModificaSegnalazioneAnonima", "SegnalazioniAnonime", new { id = segnalazione.segnalazione_anonima_id })" class="text-primary" style="font-size: 1.5em; margin-right: 10px;">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="@Url.Action("getSegnalazioneAnonimaById", "SegnalazioniAnonime", new { id = segnalazione.segnalazione_anonima_id })" class="text-info" style="font-size: 1.5em; margin-right: 10px;">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@Url.Action("GetDeletedSegnalazioneAnonimaById", "SegnalazioniAnonime", new { id = segnalazione.segnalazione_anonima_id })" class="text-danger" style="font-size: 1.5em;">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="record-not-found text-center" role="alert">
                                    Nessuna segnalazione trovata.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="align-content">
            @if (Model.TotalItems != 0)
            {
                <p style="margin-bottom: 0px;">
                    Segnalazioni:
                    @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Model.PageNumber * Model.PageSize > Model.TotalItems ? Model.TotalItems : Model.PageNumber * Model.PageSize)
                    di @Model.TotalItems
                </p>
            }

            <ul class="pagination-custom">
                <!-- Prima Pagina -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@Model.PageSize">Prima pagina</a>
                </li>

                <!-- Precedente -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Precedente</a>
                </li>

                <!-- Numeri delle pagine -->
                @{
                    var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }

                <!-- Successivo -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Successivo</a>
                </li>

                <!-- Ultima Pagina -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@Model.PageSize">Ultima pagina</a>
                </li>
            </ul>


        </div>






        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- Assicurati che jQuery sia incluso -->

        <script>
            $(document).ready(() => {
                setTimeout(() => {
                    const alertElement = $("#success-alert");
                    if (alertElement.length) {
                        alertElement.fadeOut(500, () => {
                            alertElement.remove(); // Rimuove completamente l'elemento dal DOM
                        });
                    }
                }, 5000); // Timeout di 5 secondi
            });
        </script>



        @await Html.PartialAsync("_DeleteConfirmationPartial")

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Pulsante che ha aperto il modale
                var id = button.data('segnalazioneanonimaid'); // ID della segnalazione
                $('#confirmDeleteButton').data('id', id); // Memorizza l'ID nel pulsante di conferma
            });

            // Quando si clicca su "Conferma Eliminazione"
            $('#confirmDeleteButton').on('click', function () {
                var id = $(this).data('id'); // Ottieni l'ID dal pulsante
                deleteSegnalazione(id); // Chiama la funzione per eliminare
            });

            // Funzione per eliminare una segnalazione
            function deleteSegnalazione(id) {
                $.ajax({
                    url: '/SegnalazioniAnonime/Delete', // URL dell'endpoint API
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: id }), // Passa l'ID come payload JSON
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            $('#row-' + id).remove(); // Rimuovi la riga dalla tabella
                            $('#deleteModal').modal('hide'); // Chiudi il modale
                        } else {
                            alert("Errore: " + response.message);
                        }
                    },
                    error: function (xhr) {
                        alert("Errore durante l'eliminazione: " + xhr.responseText);
                    }
                });
            }



            $(document).ready(() => {
                // Protezione contro valori di paginazione non validi
                const currentPage = parseInt('@Model.PageNumber');
                const totalPages = parseInt('@Math.Ceiling((double)Model.TotalItems / Model.PageSize)');
                if (currentPage > totalPages || currentPage < 1) {
                    alert("Pagina non valida! Reindirizzamento alla prima pagina.");
                    window.location.href = '?pageNumber=1&pageSize=@Model.PageSize';
                }

                setTimeout(() => {
                    const alertElement = $("#success-alert");
                    if (alertElement.length) {
                        alertElement.fadeOut(500, () => {
                            alertElement.remove(); // Rimuove completamente l'elemento dal DOM
                        });
                    }
                }, 5000); // Timeout di 5 secondi
            });
        </script> 


        @functions {
            public string GetStatusColor(string status)
            {
                switch (status)
                {
                    case "APERTO":
                        return "success"; // Light green
                    case "CHIUSO":
                        return "danger"; // Light red
                    default:
                        return "warning"; // Light yellow
                }
            }
        }
