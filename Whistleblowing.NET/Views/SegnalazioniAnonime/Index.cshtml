@model Whistleblowing.NET.Models.PaginatedSegnalazioniAnonimeViewModel


<link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Pagination.css" asp-append-version="true" />

<style>
    #success-alert {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }

    .title-text {
        font-size: 1.2rem;
    }

    .mini-card {
        background-color: #d4edda;
        border-radius: 7px;
        padding: 10px;
        width: 20%;
    }

    .btn-danger {
        background-color: #dc3545 !important; /* Forza il colore rosso */
        border-color: #dc3545 !important;
    }

    th {
        font-size: 1.1rem;
        vertical-align: middle;
    }






</style>

<div class="row">
    <div class="col-md-10">
        <div>
            <h3>Gestione Segnalazioni</h3>
        </div>
        <p class="title-text mt-2">
            In questa sezione del programma è possibile visualizzare tutte le segnalazioni.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="success-alert" class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>

        }
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-3 mt-1">
        <div class="card" style="border-radius: 7px; margin-bottom: 24px;">
            <div class="card-body">
                <div class="d-flex align-items-center" style="justify-content: space-between;">
                    <div>
                        <h6 class="card-subtitle mb-1 text-muted">Segnalazioni Totali:</h6>
                        <p class="font-weight-bold" style="font-size:28px;">@Model.TotalItems</p>
                    </div>
                    <i class="bi bi-exclamation-circle" style="color: black; font-size:28px;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="border-grey bg-white tab-content">
    <div class="tab-pane active" id="home" role="tabpanel" aria-labelledby="home-tab">
        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th class="text-center font-weight-bold">Codice</th>

                        <th class="text-center font-weight-bold">Data Evento</th>
                        <th class="text-center font-weight-bold">Soggetto Colpevole</th>
                        <th class="text-center font-weight-bold">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SegnalazioniAnonymous != null && Model.SegnalazioniAnonymous.Count > 0)
                    {
                        foreach (var segnalazione in Model.SegnalazioniAnonymous)
                        {
                            <tr id="row-@segnalazione.segnalazione_anonima_id">
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.segnalazione_anonima_id</td>

                                <td class="text-center" style="vertical-align: middle;">@segnalazione.DataEvento?.ToString("yyyy-MM-dd")</td>
                                <td class="text-center" style="vertical-align: middle;">@segnalazione.SoggettoColpevole</td>

                                <!-- Colonna Azioni centrata -->
                                <td class="text-center" style="vertical-align: middle;">
                                    <a class="btn btn-primary btn-sm" asp-controller="SegnalazioniAnonime" asp-action="ModificaSegnalazioneAnonima" asp-route-id="@segnalazione.segnalazione_anonima_id">
                                        <i class="bi bi-pencil-square"></i> Modifica
                                    </a>
                                    <a class="btn btn-info btn-sm" asp-controller="SegnalazioniAnonime" asp-action="getSegnalazioneAnonimaById" asp-route-id="@segnalazione.segnalazione_anonima_id">
                                        <i class="bi bi-eye"></i> Visualizza
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-controller="SegnalazioniAnonime" asp-action="GetDeletedSegnalazioneAnonimaById" asp-route-id="@segnalazione.segnalazione_anonima_id">
                                        <i class="bi bi-trash"></i> Elimina
                                    </a>
                                  @*   <a class="btn btn-danger btn-sm" asp-controller="SegnalazioniRegular" asp-action="GetDeletedSegnalazioneRegularById" asp-route-id="@segnalazione.segnalazione_anonima_id">
                                        <i class="bi bi-eye"></i> Elimina
                                    </a> *@

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="record-not-found text-center" role="alert">
                                    Nessuna segnalazione trovata.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="align-content">
            @if (Model.TotalItems != 0)
            {
                <p style="margin-bottom: 0px;">
                    Segnalazioni:
                    @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Model.PageNumber * Model.PageSize > Model.TotalItems ? Model.TotalItems : Model.PageNumber * Model.PageSize)
                    di @Model.TotalItems
                </p>
            }

            <ul class="pagination-custom">
                <!-- Prima Pagina -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@Model.PageSize">Prima pagina</a>
                </li>

                <!-- Precedente -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Precedente</a>
                </li>

                <!-- Numeri delle pagine -->
                @{
                    var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
                }
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }

                <!-- Successivo -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Successivo</a>
                </li>

                <!-- Ultima Pagina -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@Model.PageSize">Ultima pagina</a>
                </li>
            </ul>


        </div>

        @await Html.PartialAsync("_DeleteConfirmationPartial")

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
        $('#deleteModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget); // Pulsante che ha aperto il modale
        var id = button.data('segnalazioneAnonimaId'); // ID della segnalazione
        $('#confirmDeleteButton').data('id', id); // Memorizza l'ID nel pulsante di conferma
        });

        // Quando si clicca su "Conferma Eliminazione"
        $('#confirmDeleteButton').on('click', function () {
        var id = $(this).data('id'); // Ottieni l'ID dal pulsante
        deleteSegnalazione(id); // Chiama la funzione per eliminare
        });

        // Funzione per eliminare una segnalazione
        function deleteSegnalazione(id) {
        $.ajax({
        url: '/SegnalazioniAnonime/Delete', // URL dell'endpoint API
        type: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify({ id: id }), // Passa l'ID come payload JSON
        success: function (response) {
        if (response.success) {
        alert(response.message);
        $('#row-' + id).remove(); // Rimuovi la riga dalla tabella
        $('#deleteModal').modal('hide'); // Chiudi il modale
        } else {
        alert("Errore: " + response.message);
        }
        },
        error: function (xhr) {
        alert("Errore durante l'eliminazione: " + xhr.responseText);
        }
        });
        }




