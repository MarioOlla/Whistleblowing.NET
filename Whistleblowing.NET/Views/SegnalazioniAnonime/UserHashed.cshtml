@{
    ViewData["Title"] = "Dettagli Segnalazione";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    
</head>
<body>
    <div class="card">
        <h3>Informazioni Recuperate</h3>
        <p><strong>ID:</strong> @Model.id</p>
        <p><strong>Email:</strong> @Model.email</p>
        <p><strong>Codice Fiscale:</strong> @Model.codiceFiscale</p>

        <button onclick="window.history.back()" class="btn">Indietro</button>

    </div>
</body>
</html>
