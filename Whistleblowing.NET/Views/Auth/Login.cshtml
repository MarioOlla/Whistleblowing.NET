@using Whistleblowing.NET.Models.DTO
@model UtenteDTOLogin
@{
    ViewData["Title"] = "Login";
}
@{
    Layout = "_Layout_login";
}
<style>
    #success-alert {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 1050;
    }
</style>


<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card mt-4">

            <div class="card-body p-4">
                <div class="text-center mt-2">
                    <h5 class="text-primary">Bentornato !</h5>
                    <p class="text-muted">Effettua il login per continuare nell'app.</p>
                </div>
                <div class="p-2 mt-4">
                    <form asp-action="Login" method="post" class="d-flex flex-column justify-content-center">

                        <div class="form-outline mb-4">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" style="height: 100%;">
                                        <i class="bi bi-envelope" style="line-height: inherit;"></i>
                                    </span>
                                </div>
                                <input type="email" id="email" name="email" class="form-control"
                                       placeholder="Inserire una mail" />
                            </div>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span> <!-- Visualizza gli errori per l'email -->



                        <div class="form-outline mb-4">
                            <div class="form-group d-flex align-items-center">
                                <div class="input-group">
                                    <div class="input-group-prepend" id="togglePassword">
                                        <span class="input-group-text" style="height: 100%;"><i class="bi bi-eye-slash"></i></span>
                                    </div>
                                    <input type="Password" id="Password" name="Password"
                                           class="form-control" required placeholder="Inserire password" />
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span> <!-- Visualizza gli errori per la password -->

                        <div class="mb-3">
                            <div class="float-end">
                                <a asp-controller="Auth" asp-action="ForgotPassword" class="text-muted">Password dimenticata?</a>
                            </div>

                        </div>
                        @{
                            if (TempData["Errore_Login"] != null)
                            {
                                <span class="text-danger">@TempData["Errore_Login"]</span>
                            }
                        }
                        <div class="mt-4">
                            <button class="btn btn-primary w-100" type="submit">Login</button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="mt-4 text-center">
            <p class="mb-0">Non possiedi un account ? <a asp-controller="Auth" asp-action="Register" class="fw-semibold text-primary text-decoration-underline">Registrati</a></p>
        </div>

    </div>
</div>




