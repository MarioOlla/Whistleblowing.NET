<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gestione_ticket_final</title>
    <link rel="icon" href="https://www.solvingteam.it/web/wp-content/uploads/2022/02/cropped-st-32x32.png" sizes="32x32" />
    <link rel="icon" href="https://www.solvingteam.it/web/wp-content/uploads/2022/02/cropped-st-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://www.solvingteam.it/web/wp-content/uploads/2022/02/cropped-st-180x180.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/gestione_ticket_final.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-home.css" />

    <style>
        .overlay {
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: #ffffff87;
        }
    </style>
</head>
<body class="vh-100 mb-0">
    <div class="content-banner-bg" style="height: -webkit-fill-available;">
        <div></div>
        <!-- ICONA AZIENDA -->
        <header>
            <div class="">
                <div class="banner-wrap pb-4" style="padding-top: 50px !important">
                    <div class="container">
                        <div class="row gy-3 align-items-center justify-content-between mb-4">
                            <div class="text-center">
                                <a class="navbar-brand" href="https://www.solvingteam.it/">
                                    <img src="https://www.geeklogica.it/wp-content/uploads/2022/02/Group-17.png" alt="Solving Team" height="98">
                                </a>
                            </div>
                            <div class="content text-center">
                                <h1 class="banner-title display-6 mb-2 mb-md-3">
                                    <span class="text-primary title-shape title-shape-3"></span>Whistleblowing<span class="ps-1 text-primary">.</span>
                                </h1>
                                <p class="banner-text lead">
                                    La tua piattaforma per inviare segnalazioni aziendali in modo sicuro e confidenziale.
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- .container -->
                </div>
            </div>
        </header>

        <!-- ICONA AZIENDA -->


        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)

    </div>
</body>
</html>
